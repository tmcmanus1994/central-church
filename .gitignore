# dependencies
/node_modules

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# env files — .env.example is a template (blank values only) and stays tracked
.env*
!.env.example

# typescript
*.tsbuildinfo
next-env.d.ts

# python (automation/)
__pycache__/
*.pyc

# generated photo-slot screenshots (npm run shots)
/photo-slots/

# parsed bulletin drafts (npm run bulletin) — these carry the full prayer
# list, member phone numbers, and giving figures straight out of the PDF.
# Curated copy goes in src/content/bulletin.ts; the raw draft stays local.
/content-drafts/

# weekly bulletin automation's raw inbox (automation/ingest.py) — same
# reasoning as content-drafts/ above: the email and PDF carry things that
# don't belong in git history. Only lives on the Actions runner for the
# length of one workflow run. runs/*-summary.md (the human-readable output)
# is committed on purpose — it never contains what this carries.
/inbox/

# OAuth client secret downloaded from Google Cloud Console for
# get_refresh_token.py's one-time setup — never belongs in git regardless
# of where it's saved.
client_secret*.json
