# Google Calendar feeds
#
# One public iCal URL per ministry calendar. Everything on them is fetched;
# what actually reaches the site is decided by src/content/calendar-rules.ts,
# which drops staff meetings, time off, and room bookings, merges duplicate
# entries, and works out which events happen away from the building.
#
# WHERE TO FIND EACH URL
#   Google Calendar → Settings → pick the calendar → "Integrate calendar"
#   → copy "Public address in iCal format" (ends in /public/basic.ics)
#
#   If a calendar isn't fully public, use "Secret address in iCal format"
#   instead. It works the same way — just don't commit it anywhere.
#
# Set these in Vercel under Settings → Environment Variables. With none set,
# the site falls back to the seed events in src/content/events.ts and still
# builds, so a missing value never breaks a deploy.
#
# The calendar a given event lives on decides the tag it wears on the site:
#   Central Church → All Church
#   Outreach       → Outreach
#   Central Teens  → Central Teens   (also links to /ministries/teens)
#   Central Kids   → Central Kids    (also links to /ministries/children)

CALENDAR_ICS_CENTRAL_CHURCH=
CALENDAR_ICS_OUTREACH=
CALENDAR_ICS_CENTRAL_TEENS=
CALENDAR_ICS_CENTRAL_KIDS=

# Website forms
#
# Two forms email through Resend:
#   /api/kids-closet    → lacey@arcentralchurch.org
#   /api/plan-a-visit   → travelle@arcentralchurch.org (swap once it's live —
#                          this is also the site's general "Contact" fallback)
#
# Create a key at resend.com after verifying the arcentralchurch.org domain,
# then set the verified sender below.
#
# With these unset each form tells the visitor to email the recipient above
# directly and logs the submission during the build, so nothing is lost
# silently and a missing key never breaks a deploy.

RESEND_API_KEY=
FORMS_FROM_EMAIL=

# YouTube Live integration
#
# Powers the LIVE / UPCOMING / REPLAY states on the homepage "Latest from
# Central" card and /media/live — see supabase/schema.sql and
# src/lib/youtube-live.ts for how it works, and the setup guide handed off
# alongside this project for the one-time account setup.
#
# Needs a Supabase project (supabase.com → New Project) with schema.sql run
# in its SQL Editor, plus a Google Cloud project with the YouTube Data API v3
# enabled and an API key.
#
#   YOUTUBE_API_KEY           Google Cloud → APIs & Services → Credentials
#   YOUTUBE_CHANNEL_ID         YouTube Studio → Settings → Channel → Advanced
#                               settings (starts with UC, not the @handle)
#   NEXT_PUBLIC_SUPABASE_URL           Supabase → Settings → Data API
#   NEXT_PUBLIC_SUPABASE_ANON_KEY      Supabase → Settings → API Keys
#                                       ("Publishable key", sb_publishable_...)
#   SUPABASE_SERVICE_ROLE_KEY          Supabase → Settings → API Keys
#                                       ("Secret key", sb_secret_...) —
#                                       server-only, bypasses RLS, never
#                                       expose to the client
#   CRON_SECRET                        any long random string — protects
#                                       /api/youtube/poll
#
# With these unset the Live section falls back to the same static "join us
# Sunday" content the site always had — no broken build, no blank section.

YOUTUBE_API_KEY=
YOUTUBE_CHANNEL_ID=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
CRON_SECRET=
